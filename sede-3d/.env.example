# Copia este archivo como ".env" (NO se sube a git). Las claves viven SOLO aquí, en el servidor; el navegador nunca las ve.
# Dejar vacío = servicio sin conectar. Tener la clave NO activa nada: además debes autorizar cada servicio en la app (escribiendo AUTORIZO).

# IA de Claude (de pago por uso). Consigue la clave en https://platform.claude.com
ANTHROPIC_API_KEY=
# Reintento automático en otro modelo si el principal declina (on por defecto). Pon "off" para desactivarlo.
ANTHROPIC_FALLBACKS=on

# Alternativa gratuita/local: Ollama en tu PC (p. ej. http://localhost:11434/v1) u otro servicio compatible
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Búsqueda web Brave (de pago por uso) — opcional; la búsqueda por Google Noticias RSS es gratis y no necesita clave
BRAVE_SEARCH_API_KEY=
# YouTube Data API (gratis dentro de la cuota diaria) — opcional
YOUTUBE_API_KEY=

# Cifrado de tokens OAuth de redes sociales en reposo (mínimo 32 caracteres aleatorios) — solo cuando conectes cuentas
DETONADOR_TOKEN_KEY=

# Servidor (por defecto solo accesible desde este equipo)
DETONADOR_HOST=127.0.0.1
DETONADOR_PORT=8787
# Pon 1 si lo sirves por HTTPS
DETONADOR_SECURE_COOKIES=0
